# ============================ Concurrency / scaling ===========================
# Worker processes (uvicorn --workers). Set near your core count; each worker is
# a full event loop. Only ONE worker (leader, elected via a file lock) runs the
# warmup/relogin/token-warm loops, so raising this does NOT multiply logins.
# Browser pools are per-worker, so total Chromium ≈ API_WORKERS × X_BROWSER_POOL_MAX
# — budget RAM accordingly (~400MB each).
API_WORKERS=4
# Shared thread pool for blocking curl_cffi / yt-dlp calls (Reddit/YouTube/X-warm).
# asyncio's default (~8-16) caps HTTP-scraper concurrency below 100; raise it.
# These threads are network-bound, so >> core count is fine.
API_THREAD_POOL_SIZE=128

# --- Reddit latency tuning (no extra accounts needed) ---
# Connect-phase timeout, split from the read timeout: a dead rotating proxy fails
# CONNECT fast and the loop rotates, instead of burning the full read timeout.
REDDIT_CONNECT_TIMEOUT=5.0
# Max wall-clock a single request waits on a fully-exhausted account pool before
# 503 (with Retry-After). Lower = snappier 503s / higher throughput; higher =
# more requests wait out the rate-limit window and succeed. Tune to taste.
REDDIT_EXHAUSTION_WAIT_BUDGET=12.0
# Cross-worker cooldown sharing (sessions/reddit_cooldowns.json) so --workers N
# don't each re-hammer the same throttled account. Set false for single-process.
REDDIT_SHARED_COOLDOWN=true
# Proactive per-account rate limiting (token bucket). Paces each account to its
# per-minute budget BEFORE hitting Reddit, so bursts are smoothed and excess is
# shed with 503 + Retry-After instead of thrashing into 429s. The budget is split
# across workers (RPM / API_WORKERS per account). Reddit's real limit is ~100/min;
# 90 leaves headroom. Lower if you still see 429s; set ENABLED=false to disable.
REDDIT_RATE_LIMIT_ENABLED=true
REDDIT_ACCOUNT_RPM=90
# Strict cross-worker exclusivity: an account leased by one worker can't be used
# by any other worker until released (no two concurrent requests on one account,
# the strongest anti-ban guarantee). Trade-off: total in-flight is capped at the
# number of accounts, not REDDIT_MAX_INFLIGHT × workers. Uses an OS file lock
# (auto-released if a worker crashes). Set false for rate-limited-but-shared.
REDDIT_EXCLUSIVE_ACCOUNTS=true

# LinkedIn per-account rate cap (same token-bucket mechanism, split RPM /
# API_WORKERS per account). The pool's in_use flag only serializes one li_at
# WITHIN a process, so under --workers N this is what stops N workers hitting the
# same account at once. LinkedIn bans hard — keep this conservative.
LINKEDIN_RATE_LIMIT_ENABLED=true
LINKEDIN_ACCOUNT_RPM=20
# Strict cross-worker exclusivity for LinkedIn (one worker per li_at at a time).
LINKEDIN_EXCLUSIVE_ACCOUNTS=true

# Automatic Reddit re-login. When true, an account whose session is expired/aged/
# missing (or that returns 401) is re-logged-in via a real browser instead of just
# being skipped. Needs a display for headful Chromium — the deploy runs under xvfb.
# Leave false for a saved-sessions-only box (no browser logins). Default false.
REDDIT_AUTO_RELOGIN=true
# Runs the PROACTIVE background health sweep (leader worker only): keeps every
# account's session alive ahead of demand, not just reactively on a 401. Requires
# REDDIT_AUTO_RELOGIN=true to actually relogin. Default true.
REDDIT_VALIDATE_ON_STARTUP=true
# Re-sweep interval in seconds (0 = run once at startup, no repeat).
REDDIT_HEALTH_CHECK_INTERVAL=300
# Max concurrent browser relogins (each is a Chromium launch — keep small).
REDDIT_RELOGIN_CONCURRENCY=2


# Account Ban/Shadowban Detection & Safeguarding Layer

# Master switch to enable/disable passive signal classification and active probes
ACCOUNT_BAN_DETECTION=true

# Gating rotation/protection mode. When true, terminal states are excluded from selection
# and at-risk accounts are demoted to fallback-only. Set to false for observe-only.
ACCOUNT_BAN_PROTECT=false

# Warning risk threshold to transition account state to 'at_risk'
BAN_RISK_WARN=6.0

# Suspect risk threshold to transition account state to 'shadow_suspected'
BAN_RISK_SUSPECT=10.0

# Decay rate applied to risk score on successful requests ('ok' signal)
BAN_RISK_DECAY=0.85

# Number of consecutive 403 Forbidden errors before transition to 'shadow_suspected'
BAN_FORBIDDEN_STREAK=4

# Post-ban cooldown in seconds. Once an account is confirmed in a terminal
# ban state (suspended/shadow_confirmed/restricted), it stays quarantined for
# at least this long. Active probes that would normally clear the state are
# refused during the window; after it elapses, the next successful probe can
# recover the account. Survives server restart via sessions/ban_state.json.
BAN_CONFIRMED_COOLDOWN_SECONDS=86400


# ============================ Rotating proxy pool =============================
# good-proxies.ru rotating pool. Provide your own key in .env (never commit it).
GOODPROXIES_ENABLED=true
# GOODPROXIES_API_KEY=          # set in .env, not here
# GOODPROXIES_API_URL=https://api.good-proxies.ru/api

# Supply/quality. NOTE: `count` barely matters — the API returns its available
# matching set (capped by supply), not `count`. The REAL supply levers are ANON
# and MAX_PING. Measured: ping<=500 + elite => ~4 live/fetch; ping<=1500 +
# elite,anonymous => ~40-50 live/fetch, accumulating to ~76 unique over a few
# fetches. ANON=elite,anonymous still hides your IP. MAX_PING is the provider's
# latency filter (ms); higher = more supply, slightly slower proxies.
GOODPROXIES_COUNT=2000
GOODPROXIES_ANON=elite,anonymous
GOODPROXIES_MAX_PING=1500
GOODPROXIES_HEALTHCHECK_TIMEOUT=3
GOODPROXIES_HEALTHCHECK_WORKERS=120
# Multi-target liveness: a proxy is "live" only if it reaches EVERY URL here, so
# the pool is pre-verified for all services (e.g. Reddit AND LinkedIn) — no
# service ever fetches through a proxy that can't reach it. Comma-separated;
# unset = single GOODPROXIES_HEALTHCHECK_URL. Trade-off: stricter = fewer live.
GOODPROXIES_HEALTHCHECK_URLS=https://www.reddit.com/,https://www.linkedin.com/robots.txt

# Pool size / freshness. ~80-100 live is the good-proxies ceiling AND is plenty:
# saturating 13 accounts (19.5 req/s) at ~1.2s proxy latency needs only ~24
# proxies in flight, so ~80 live shared across workers is comfortable headroom.
GOODPROXIES_TARGET_LIVE=90
GOODPROXIES_MIN_LIVE=70
GOODPROXIES_ENRICH_INTERVAL=10
GOODPROXIES_REFRESH_SECONDS=15
GOODPROXIES_REVERIFY_FAILS=2
GOODPROXIES_REVERIFY_GRACE_CYCLES=2
# Dead-proxy blocklist: a proxy that fails a real request or fails re-verification
# is recorded in sessions/proxy_dead.json and NEVER re-admitted to any worker's
# pool (no cooldown-and-reuse of dead IPs). Shared across workers; resets on
# restart. Admission also requires TWO probe passes (robust liveness). Set false
# to restore temporary-cooldown behavior. COOLDOWN_SECONDS is then the rest time.
GOODPROXIES_BLOCKLIST_DEAD=true
GOODPROXIES_COOLDOWN_SECONDS=30

# ===================== X (Nitter) Cloudflare token cache ======================
# A solved cf_clearance is UA-bound, not IP-bound, so one token serves the whole
# rotating fleet. Cached per instance, reused across restarts. Effective token
# life ~60min; TTL is the cache window with margin.
X_SESSION_TTL_SECONDS=3000
# Cheap-path: split timeout (dead proxy fails at CONNECT ~5s; working proxy gets
# READ for the ~77KB transfer) and retry the portable token across live proxies.
X_DIRECT_CONNECT_TIMEOUT_SECONDS=5
X_DIRECT_TIMEOUT_SECONDS=8
X_CHEAP_PROXY_RETRIES=2
# Cloudflare detection polls before concluding "no challenge" (backstopped by
# _check_page_for_blocks).
X_CF_DETECT_POLLS=2
# Out-of-band warmer: mints/refreshes instance tokens off the request path
# (refresh < the ~50min TTL). Set X_INLINE_BROWSER_SOLVE=false to forbid inline
# browser solves at request time once warming is proven for your instances.
X_WARMUP_ON_STARTUP=true
X_TOKEN_WARM_INTERVAL=2400
X_WARM_INITIAL_DELAY=15
X_INLINE_BROWSER_SOLVE=false
