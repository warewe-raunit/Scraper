# Account Ban/Shadowban Detection & Safeguarding Layer

# Master switch to enable/disable passive signal classification and active probes
ACCOUNT_BAN_DETECTION=true

# Gating rotation/protection mode. When true, terminal states are excluded from selection
# and at-risk accounts are demoted to fallback-only. Set to false for observe-only.
ACCOUNT_BAN_PROTECT=false

# Warning risk threshold to transition account state to 'at_risk'
BAN_RISK_WARN=6.0

# Suspect risk threshold to transition account state to 'shadow_suspected'
BAN_RISK_SUSPECT=10.0

# Decay rate applied to risk score on successful requests ('ok' signal)
BAN_RISK_DECAY=0.85

# Number of consecutive 403 Forbidden errors before transition to 'shadow_suspected'
BAN_FORBIDDEN_STREAK=4

# Post-ban cooldown in seconds. Once an account is confirmed in a terminal
# ban state (suspended/shadow_confirmed/restricted), it stays quarantined for
# at least this long. Active probes that would normally clear the state are
# refused during the window; after it elapses, the next successful probe can
# recover the account. Survives server restart via sessions/ban_state.json.
BAN_CONFIRMED_COOLDOWN_SECONDS=86400


# ============================ Rotating proxy pool =============================
# good-proxies.ru rotating pool. Provide your own key in .env (never commit it).
GOODPROXIES_ENABLED=true
# GOODPROXIES_API_KEY=          # set in .env, not here
# GOODPROXIES_API_URL=https://api.good-proxies.ru/api

# Supply/quality. ~70% of any fetched batch is dead, so fetch wide; the
# healthcheck is the real gate. MAX_PING is the provider's lightweight latency
# filter (ms), not the request timeout. Measured live supply ~57-67.
GOODPROXIES_COUNT=300
GOODPROXIES_MAX_PING=1000
GOODPROXIES_HEALTHCHECK_TIMEOUT=3
GOODPROXIES_HEALTHCHECK_WORKERS=120

# Pool size / freshness. TARGET_LIVE captures most live supply; MIN_LIVE is the
# floor that triggers top-up, kept high so a burst can't drain the pool. Short
# ENRICH/REFRESH keep proxies freshly verified (more CPU/API, cheap here).
GOODPROXIES_TARGET_LIVE=55
GOODPROXIES_MIN_LIVE=45
GOODPROXIES_ENRICH_INTERVAL=5
GOODPROXIES_REFRESH_SECONDS=15
GOODPROXIES_REVERIFY_FAILS=2
GOODPROXIES_REVERIFY_GRACE_CYCLES=2
GOODPROXIES_COOLDOWN_SECONDS=30

# ===================== X (Nitter) Cloudflare token cache ======================
# A solved cf_clearance is UA-bound, not IP-bound, so one token serves the whole
# rotating fleet. Cached per instance, reused across restarts. Effective token
# life ~60min; TTL is the cache window with margin.
X_SESSION_TTL_SECONDS=3000
# Cheap-path: split timeout (dead proxy fails at CONNECT ~5s; working proxy gets
# READ for the ~77KB transfer) and retry the portable token across live proxies.
X_DIRECT_CONNECT_TIMEOUT_SECONDS=5
X_DIRECT_TIMEOUT_SECONDS=8
X_CHEAP_PROXY_RETRIES=2
# Cloudflare detection polls before concluding "no challenge" (backstopped by
# _check_page_for_blocks).
X_CF_DETECT_POLLS=2
# Out-of-band warmer: mints/refreshes instance tokens off the request path
# (refresh < the ~50min TTL). Set X_INLINE_BROWSER_SOLVE=false to forbid inline
# browser solves at request time once warming is proven for your instances.
X_WARMUP_ON_STARTUP=true
X_TOKEN_WARM_INTERVAL=2400
X_WARM_INITIAL_DELAY=15
X_INLINE_BROWSER_SOLVE=false
